{
  "name": "tasman",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "tsx database/migrate.cli.ts",
    "migrate:test": "tsx scripts/migrate-test.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:integration": "npm run migrate:test && NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/integration",
    "container:up": "docker compose -f docker-compose.test.yml up -d",
    "container:down": "docker compose -f docker-compose.test.yml down",
    "container:remove": "docker compose -f docker-compose.test.yml down -v",
    "start:prod": "npm run build && npm run migrate && npm start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quoc-Dat-Ngo/tasman.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Quoc-Dat-Ngo/tasman/issues"
  },
  "homepage": "https://github.com/Quoc-Dat-Ngo/tasman#readme",
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.17.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  }
}
